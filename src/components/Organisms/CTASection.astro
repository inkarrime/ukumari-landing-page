---
interface Props {
    title: string;
    description: string;
    ctaText?: string;
    ctaLink?: string;
    class?: string;
    target?: '_blank' | '_self' | '_parent' | '_top';
    rel?: string;
    ariaLabel?: string;
}

const {
    title,
    description,
    ctaText = 'Join our Discord',
    ctaLink = '#',
    class: className = '',
    target = '_blank',
    rel = 'noopener noreferrer',
    ariaLabel
} = Astro.props;
---

<section class={`cta-section ${className}`}>
    <div class="container">
        <h2 class="cta-title">{title}</h2>
        <p class="cta-description">{description}</p>
        <a href={ctaLink} target={target}
           rel={target === '_blank' ? rel : undefined}
           class={`link ${className}`}
           aria-label={ariaLabel }>
            {ctaText}
        </a>
    </div>
</section>

<style>
    .link{
        background-color: #5289FF;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        text-decoration: none;
    }

    .link:hover {
        background: #2563eb;
    }

    .cta-section {
        padding: 6rem 2rem;
        background: #000000;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

    /* Efecto de fondo sutil */
    .cta-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
                circle at 50% 50%,
                rgba(59, 130, 246, 0.1) 0%,
                transparent 70%
        );
        pointer-events: none;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .cta-title {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        margin: 0 0 1.5rem 0;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .cta-description {
        font-size: clamp(1.125rem, 2.5vw, 1.375rem);
        margin: 0 0 2.5rem 0;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.6;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    @media (max-width: 768px) {
        .cta-section {
            padding: 4rem 1.5rem;
        }

        .cta-description {
            margin-bottom: 2rem;
        }
    }
</style>