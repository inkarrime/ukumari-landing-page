---
import Button from '../Atoms/Button.astro';

interface Props {
    title: string;
    subtitle: string;
    ctaText?: string;
    ctaLink?: string;
    class?: string;
    arget?: '_blank' | '_self' | '_parent' | '_top';
    rel?: string;
    ariaLabel?: string;
}

const {
    title,
    subtitle,
    ctaText = 'Join our Discord',
    ctaLink = '#',
    class: className = '',
    target = '_blank',
    rel = 'noopener noreferrer',
    ariaLabel
} = Astro.props;
---

<section class={`banner ${className}`}>
        <h1 class="title">{title}</h1>
        <p class="subtitle">{subtitle}</p>
        <a href={ctaLink} target={target}
           rel={target === '_blank' ? rel : undefined}
           class={`link ${className}`}
           aria-label={ariaLabel }>
            {ctaText}
        </a>
</section>

<style>
        .link{
                background-color: #5289FF;
                padding: 0.5rem 1rem;
                border-radius: 0.375rem;
                text-decoration: none;
        }

        .link:hover {
                background: #2563eb;
        }
    .banner {
        padding: 12rem var(--padding-1);
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        overflow: hidden;
        background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.5) 100%), url("../../assets/hero-bg.png");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center center;

        & .title {
            font-size: clamp(2.5rem, 8vw, 5rem);
            font-weight: 700;
            margin: 0 0 1rem 0;
            line-height: 1.1;
        }

        & .subtitle {
            font-size: clamp(1.125rem, 3vw, 1.5rem);
            margin: 0 0 2rem 0;
            color: rgba(255, 255, 255, 0.9);
        }
    }
</style>