---
import CollaboratorCard from '../Molecules/CollaboratorCard.astro';

interface Collaborator {
    name: string;
    role: string;
    image?: string;
    href?: string;
}

interface Props {
    title?: string;
    collaborators?: Collaborator[];
    class?: string;
}

const {
    title = 'Our Collaborators',
    collaborators = [],
    class: className = ''
} = Astro.props;
---

<section class={`collaborators-section ${className}`}>
    <div class="container">
        <h2 class="section-title">{title}</h2>

        {collaborators.length > 0 ? (
                <div class="collaborators-grid">
                    {collaborators.map(collaborator => (
                            <CollaboratorCard {...collaborator} />
                    ))}
                </div>
        ) : (
                <p class="no-collaborators">No collaborators to display yet.</p>
        )}
    </div>
</section>

<style>
    .collaborators-section {
        padding: 5rem 2rem;
        background: #000000;
        color: white;
        position: relative;
    }

    /* Efecto de fondo sutil */
    .collaborators-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
                radial-gradient(circle at 20% 30%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
        pointer-events: none;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .section-title {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        text-align: center;
        margin: 0 0 4rem 0;
        letter-spacing: -0.02em;
    }

    .collaborators-grid {
       display: grid;
        grid-auto-rows: minmax(240px, auto);
        grid-template-columns: repeat(auto-fit, minmax(8rem, 10rem));
        gap: 2rem;
        justify-content: center;
    }

    .no-collaborators {
        text-align: center;
        color: rgba(255, 255, 255, 0.4);
        font-size: 1.125rem;
        padding: 3rem;
    }

    @media (max-width: 640px) {
        .collaborators-section {
            padding: 3rem 1rem;
        }

        .section-title {
            margin-bottom: 2.5rem;
            font-size: 2rem;
        }
    }
</style>