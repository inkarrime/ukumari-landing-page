---
import UkumariLogo from '../../assets/logotipo.png';
import Logo from '../Atoms/Logo.astro';
import NavMenu from '../Molecules/NavMenu.astro';
import SocialLinks from '../Molecules/SocialLinks.astro';
---

<header class="topbar">
    <Logo
        icon = {UkumariLogo}
        text="Ukumari Studio"
    />

    <!--<NavMenu items={[-->
    <!--    { label: 'Projects', href: '/projects' },-->
    <!--    { label: 'Shops', href: '/shops' },-->
    <!--    { label: 'News', href: '/news' }-->
    <!--]} />-->

    <SocialLinks />
</header>

<style>
    .topbar {
        display: none;
        @media screen and (min-width: 768px) {
            max-width: 1440px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 1rem 2rem;
            color: white;

        }
    }
</style>