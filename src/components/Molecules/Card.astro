---
interface Props {
    title: string;
    description: string;
    tags: string;
    image: string;
    platform: 'minecraft' | 'roblox';
    platformIcon: string;
    href?: string;
    class?: string;
}

const {
    title,
    description,
    tags,
    image,
    platform,
    platformIcon,
    href,
    class: className = ''
} = Astro.props;

const Card = href ? 'a' : 'div';
---

<Card href={href} class={`project-card ${className}`}>
    <div class="project-image">
        <img src={image} alt={title} />
    </div>
    <div class="project-content">
        <h3 class="project-title">{title}</h3>
        <p class="project-description">{description}</p>
        <p class="project-tags">{tags}</p>
        <div class="project-platform">
            <img src={platformIcon} alt={platform} class="platform-icon" />
        </div>
    </div>
</Card>

<style>
    .project-card {
        background: rgba(0, 0, 0, 0.6);
        border-radius: 0.5rem;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .project-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .project-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #000;
        position: relative;
    }

    .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.4s ease;
    }

    .project-card:hover .project-image img {
        transform: scale(1.1);
    }

    .project-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
    }

    .project-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        color: #ffffff;
        line-height: 1.2;
    }

    .project-description {
        font-size: 0.9375rem;
        color: rgba(255, 255, 255, 0.7);
        margin: 0;
        line-height: 1.4;
    }

    .project-tags {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
        line-height: 1.4;
    }

    .project-platform {
        display: flex;
        align-items: center;
        margin-top: auto;
        padding-top: 0.5rem;
    }

    .platform-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
        filter: brightness(1.2);
        transition: transform 0.2s ease;
    }

    .project-card:hover .platform-icon {
        transform: scale(1.1);
    }
</style>